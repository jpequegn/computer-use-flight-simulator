{
  "name": "computer-use-flight-simulator",
  "version": "0.1.0",
  "description": "Deterministic adversarial browser scenarios and process evals for computer-use agents",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && vite build",
    "dev": "concurrently -k -n api,web -c cyan,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:web": "vite",
    "start": "node dist/src/server/main.js",
    "start:e2e": "npm run build && NODE_ENV=production PORT=4318 node dist/src/server/main.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "keywords": [
    "computer-use",
    "browser-agent",
    "evaluation",
    "playwright"
  ],
  "author": "Julien Pequegnot",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.34.0",
    "globals": "^16.3.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.6.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "fastify": "^5.12.1",
    "lucide-react": "^1.34.0",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  }
}
